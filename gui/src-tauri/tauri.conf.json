{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forager",
  "version": "0.1.8",
  "identifier": "io.github.aalmansadath.Forager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build && cargo build --release -p forager-cli && ../packaging/gen-docs.sh ../target/release/forager ../target/release/share",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Forager",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; worker-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "publisher": "Aalman Sadath",
    "shortDescription": "Install and update apps from their forge releases",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "longDescription": "Tracks apps on GitHub, GitLab and Codeberg, picks the release asset that fits this system, verifies it, and installs it with the system package manager, as a Flatpak, an AppImage or a tarball.",
    "linux": {
      "deb": {
        "desktopTemplate": "forager.desktop.hbs",
        "files": {
          "/usr/bin/forager": "../../target/release/forager",
          "/usr/share/bash-completion/completions": "../../target/release/share/bash-completion/completions",
          "/usr/share/zsh/site-functions": "../../target/release/share/zsh/site-functions",
          "/usr/share/fish/vendor_completions.d": "../../target/release/share/fish/vendor_completions.d",
          "/usr/share/man/man1": "../../target/release/share/man/man1"
        },
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      },
      "rpm": {
        "desktopTemplate": "forager.desktop.hbs",
        "files": {
          "/usr/bin/forager": "../../target/release/forager",
          "/usr/share/bash-completion/completions": "../../target/release/share/bash-completion/completions",
          "/usr/share/zsh/site-functions": "../../target/release/share/zsh/site-functions",
          "/usr/share/fish/vendor_completions.d": "../../target/release/share/fish/vendor_completions.d",
          "/usr/share/man/man1": "../../target/release/share/man/man1"
        },
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ]
      },
      "appimage": {
        "files": {
          "/usr/bin/forager": "../../target/release/forager"
        }
      }
    },
    "copyright": "Copyright © 2026 Aalman Sadath. GPL-3.0-or-later.",
    "license": "GPL-3.0-or-later"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["forager"]
      }
    }
  },
  "mainBinaryName": "forager-gui"
}
